{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tenboards",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true
  // To use your database, set your Worker name above and add your real nonsecret ID.
  // Disable Hyperdrive caching; follow docs/deploy.md to stage binding + auth together.
  // No active binding and no auth secret keeps the zero-config demo.
  // , "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "YOUR_REAL_HYPERDRIVE_ID" }]
}
