# Optional local Docker database; leave DATABASE_URL unset for zero-config demo.
DATABASE_URL=postgresql://tenboards:tenboards_local@127.0.0.1:54329/tenboards
# DATA_SOURCE=demo forces demo even when DATABASE_URL is configured; unset the auth secret too.

# Optional authentication: requires a migrated local DB source (not DATA_SOURCE=demo).
# Generate a private random secret locally: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Compiled local Worker: npm run build && npm run worker:dev -- --binding
# Use BETTER_AUTH_URL=http://localhost:3021 for this local runtime.
# The helper writes ignored localConnectionString config, never a remote binding.

# Production provisioning/secrets are reviewer-only: see docs/deploy.md.
# Remote migrate/seed requires --allow-remote and a DIRECT TLS URL.
# Never put production secrets in this example or a preview build.

# Optional adopter-owned Assistant providers; keep all unset for recorded replies.
# Keys are server-only. Never prefix them with VITE_. Never use real keys in previews/tests.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# META_API_KEY=
# META_MODEL=muse-spark-1.3
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.8-flash
# Hosted live auth-off requires an explicit HTTPS origin; auth-on must agree with BETTER_AUTH_URL.
# ASSISTANT_ORIGIN=https://your-own-dashboard.example
