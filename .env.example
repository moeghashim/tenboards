# Optional local Docker database; leave DATABASE_URL unset for zero-config demo.
DATABASE_URL=postgresql://tenboards:tenboards_local@127.0.0.1:54329/tenboards
# DATA_SOURCE=demo forces demo even when DATABASE_URL is configured; unset the auth secret too.

# Optional authentication: requires a migrated local DB source (not DATA_SOURCE=demo).
# Generate a private random secret locally: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
