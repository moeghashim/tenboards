@@ -0,0 +1,8 @@
+import { createServerFn } from "@tanstack/react-start";
+
+export const loadVendors = createServerFn({ method: "GET" }).handler(async () => {
+  const { requireSession } = await import("@/lib/auth/session.server");
+  await requireSession();
+  const { readVendors } = await import("@/server/data/vendors");
+  return readVendors();
+});
