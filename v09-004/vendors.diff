index 0000000..95886a6
--- /dev/null
+++ b/src/routes/(main)/dashboard/vendors/index.tsx
@@ -0,0 +1,15 @@
+import { createFileRoute } from "@tanstack/react-router";
+
+import { requireAppRoute } from "@/lib/auth/app-route";
+
+import { loadVendors } from "./-components/load";
+import { VendorsPage } from "./-components/page";
+
+export const Route = createFileRoute("/(main)/dashboard/vendors/")({
+  beforeLoad: requireAppRoute,
+  loader: () => loadVendors(),
+  component: Page,
+});
+function Page() {
+  return <VendorsPage data={Route.useLoaderData()} />;
+}
