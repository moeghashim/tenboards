+import { CardContent, DashboardCard, PageHeader, SectionHeader } from "@/components/blocks";
+import type { VendorsData } from "@/server/data/vendors.types";
+
+import { RecordsTable } from "./records-table";
+
+export function VendorsPage({ data }: { data: VendorsData }) {
+  return (
+    <section className="min-w-0 space-y-5" aria-label={"Vendors"}>
+      <PageHeader title={"Vendors"} description="Suppliers and service providers your team buys from." />
+      <DashboardCard>
+        <SectionHeader
+          title="Vendor directory"
+          description="Sample vendor records. Sort columns or browse the next page."
+        />
+        <CardContent>
+          <RecordsTable records={data.records} />
+        </CardContent>
+      </DashboardCard>
+    </section>
+  );
+}
diff --git a/src/routes/(main)/dashboard/vendors/-components/records-table.tsx b/src/routes/(main)/dashboard/vendors/-components/records-table.tsx
new file mode 100644
index 0000000..8833f13
--- /dev/null
+++ b/src/routes/(main)/dashboard/vendors/-components/records-table.tsx
@@ -0,0 +1,51 @@
+import { type ColumnDef, useTable } from "@tanstack/react-table";
+
+import { cn } from "cn";
+
+import { DataTable, type DataTableFeatures, dataTableFeatures, formatCurrency } from "@/components/blocks";
+import { Badge } from "@/components/ui/badge";
+import type { VendorStatus, VendorsRecord } from "@/server/data/vendors.types";
+
+const statusClasses: Record<VendorStatus, string> = {
+  Active: "bg-success-surface text-success",
+  Onboarding: "bg-info-surface text-info",
+  "Under review": "bg-warning-surface text-warning",
+  Inactive: "bg-muted text-muted-foreground",
+};
+
+const columns: ColumnDef<DataTableFeatures, VendorsRecord>[] = [
+  { accessorKey: "id", header: "Vendor ID", sortFn: "alphanumeric" },
+  {
+    accessorKey: "name",
+    header: "Vendor",
+    sortFn: "text",
+    cell: ({ row }) => <span className="font-medium">{row.original.name}</span>,
+  },
+  { accessorKey: "category", header: "Category", sortFn: "text" },
+  { accessorKey: "contact", header: "Primary contact", sortFn: "text" },
+  {
+    accessorKey: "status",
+    header: "Status",
+    sortFn: "text",
+    cell: ({ row }) => (
+      <Badge variant="secondary" className={cn("rounded-md", statusClasses[row.original.status])}>
+        {row.original.status}
+      </Badge>
+    ),
+  },
+  {
+    accessorKey: "annualSpend",
+    header: "Annual spend",
+    cell: ({ row }) => <span className="tabular-nums">{formatCurrency(row.original.annualSpend)}</span>,
+  },
+];
+export function RecordsTable({ records }: { records: VendorsRecord[] }) {
+  const table = useTable({
+    features: dataTableFeatures,
+    data: records,
+    columns,
+    getRowId: (row) => row.id,
+    initialState: { pagination: { pageIndex: 0, pageSize: 5 } },
+  });
+  return <DataTable table={table} label="Vendors" mobile="reflow" empty="No vendors to display yet." />;
+}
diff --git a/src/routes/(main)/dashboard/vendors/index.tsx b/src/routes/(main)/dashboard/vendors/index.tsx
