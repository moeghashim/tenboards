index 0000000..ef05071
--- /dev/null
+++ b/src/routes/(main)/dashboard/sales/-components/activity-chart.tsx
@@ -0,0 +1,73 @@
+import { type ColumnDef, useTable } from "@tanstack/react-table";
+
+import {
+  CartesianGrid,
+  chartAxis,
+  chartCursor,
+  chartGrid,
+  DashboardChart,
+  DashboardLegend,
+  DashboardTooltip,
+  DataTable,
+  type DataTableFeatures,
+  dataTableFeatures,
+  formatCurrency,
+  Legend,
+  Line,
+  LineChart,
+  seriesConfig,
+  Tooltip,
+  useChartMotion,
+  XAxis,
+  YAxis,
+} from "@/components/blocks";
+import type { SalesPoint } from "@/server/data/sales.types";
+
+const config = seriesConfig({ revenue: "Net revenue" });
+const columns: ColumnDef<DataTableFeatures, SalesPoint>[] = [
+  { accessorKey: "day", header: "Date", enableSorting: false },
+  {
+    accessorKey: "revenue",
+    header: "Net revenue (USD)",
+    enableSorting: false,
+    cell: ({ getValue }) => formatCurrency(getValue<number>()),
+  },
+];
+export function RevenueChart({ data }: { data: SalesPoint[] }) {
+  const motion = useChartMotion();
+  const table = useTable({ features: dataTableFeatures, data, columns, getRowId: (row) => row.day });
+  if (!data.length) return <p className="text-muted-foreground text-sm">No revenue data in this reporting period.</p>;
+  return (
+    <div className="min-w-0 space-y-4">
+      <DashboardChart config={config} aria-label="Daily net revenue in USD; exact values in View chart data below">
+        <LineChart data={data} accessibilityLayer>
+          <CartesianGrid {...chartGrid} />
+          <XAxis dataKey="day" {...chartAxis} />
+          <YAxis {...chartAxis} tickFormatter={(value: number) => formatCurrency(value)} width={80} />
+          <Tooltip
+            {...motion}
+            cursor={chartCursor}
+            content={
+              <DashboardTooltip formatter={(value) => <span>Net revenue: {formatCurrency(Number(value))}</span>} />
+            }
+          />
+          <Legend content={<DashboardLegend config={config} />} />
+          <Line
+            dataKey="revenue"
+            stroke={config.revenue.color}
+            strokeDasharray={config.revenue.strokeDasharray}
+            strokeWidth={2}
+            dot
+            {...motion}
+          />
+        </LineChart>
+      </DashboardChart>
+      <details>
+        <summary className="w-fit cursor-pointer rounded-sm text-sm underline underline-offset-4">
+          View chart data
+        </summary>
+        <DataTable table={table} label="Daily net revenue in USD" mobile="reflow" pagination={false} />
+      </details>
+    </div>
+  );
+}
