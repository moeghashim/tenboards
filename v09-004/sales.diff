@@ -0,0 +1,50 @@
+import {
+  CardContent,
+  DashboardCard,
+  formatCurrency,
+  formatNumber,
+  PageHeader,
+  SectionHeader,
+  StatCard,
+} from "@/components/blocks";
+import type { SalesData } from "@/server/data/sales.types";
+
+import { RevenueChart } from "./activity-chart";
+import { TopProductsTable } from "./records-table";
+
+export function SalesPage({ data }: { data: SalesData }) {
+  const { netRevenue, orders } = data.metrics;
+  return (
+    <section className="min-w-0 space-y-5" aria-label="Sales">
+      <PageHeader title="Sales" description="Demo sales · October 19–23, 2026 · All amounts in USD." />
+      <div className="grid gap-4 sm:grid-cols-3">
+        <StatCard
+          label="Net revenue"
+          value={formatCurrency(netRevenue)}
+          help="After discounts and returns; excludes tax and shipping."
+        />
+        <StatCard label="Paid orders" value={formatNumber(orders)} help="Orders included in this reporting period." />
+        <StatCard
+          label="Average order value"
+          value={orders ? formatCurrency(netRevenue / orders) : "—"}
+          help="Net revenue divided by paid orders."
+        />
+      </div>
+      <DashboardCard>
+        <SectionHeader title="Daily revenue" description="Net revenue across the five-day reporting period." />
+        <CardContent>
+          <RevenueChart data={data.revenue} />
+        </CardContent>
+      </DashboardCard>
+      <DashboardCard>
+        <SectionHeader
+          title="Top products"
+          description="Products sold this period, ranked by net revenue. Orders may include multiple products."
+        />
+        <CardContent>
+          <TopProductsTable products={data.products} />
+        </CardContent>
+      </DashboardCard>
+    </section>
+  );
+}
diff --git a/src/routes/(main)/dashboard/sales/-components/records-table.tsx b/src/routes/(main)/dashboard/sales/-components/records-table.tsx
new file mode 100644
index 0000000..265ef63
--- /dev/null
+++ b/src/routes/(main)/dashboard/sales/-components/records-table.tsx
@@ -0,0 +1,45 @@
+import { type ColumnDef, useTable } from "@tanstack/react-table";
+
+import {
+  DataTable,
+  type DataTableFeatures,
+  dataTableFeatures,
+  formatCurrency,
+  formatNumber,
+} from "@/components/blocks";
+import type { SalesProduct } from "@/server/data/sales.types";
+
+const columns: ColumnDef<DataTableFeatures, SalesProduct>[] = [
+  { accessorKey: "name", header: "Product", sortFn: "text" },
+  { accessorKey: "id", header: "SKU", sortFn: "alphanumeric" },
+  { accessorKey: "category", header: "Category", sortFn: "text" },
+  {
+    accessorKey: "units",
+    header: "Units sold",
+    sortFn: (a, b, columnId) => a.getValue<number>(columnId) - b.getValue<number>(columnId),
+    cell: ({ getValue }) => formatNumber(getValue<number>()),
+  },
+  {
+    accessorKey: "revenue",
+    header: "Net revenue",
+    sortFn: (a, b, columnId) => a.getValue<number>(columnId) - b.getValue<number>(columnId),
+    cell: ({ getValue }) => formatCurrency(getValue<number>()),
+  },
+];
+export function TopProductsTable({ products }: { products: SalesProduct[] }) {
+  const table = useTable({
+    features: dataTableFeatures,
+    data: products,
+    columns,
+    getRowId: (row) => row.id,
+    initialState: { sorting: [{ id: "revenue", desc: true }], pagination: { pageIndex: 0, pageSize: 5 } },
+  });
+  return (
+    <DataTable
+      table={table}
+      label="Top products by net revenue"
+      mobile="reflow"
+      empty="No product sales in this reporting period."
+    />
+  );
+}
