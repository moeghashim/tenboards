+import { createFileRoute } from "@tanstack/react-router";
+
+import { requireAppRoute } from "@/lib/auth/app-route";
+
+import { loadSales } from "./-components/load";
+import { SalesPage } from "./-components/page";
+
+export const Route = createFileRoute("/(main)/dashboard/sales/")({
+  beforeLoad: requireAppRoute,
+  loader: () => loadSales(),
+  component: Page,
+});
+function Page() {
+  return <SalesPage data={Route.useLoaderData()} />;
+}
